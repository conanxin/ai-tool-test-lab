# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.venv-castform-local/
.venv*/

# Node (even if not used, guard against accidental commits)
node_modules/
package-lock.json

# Secrets — NEVER commit these
.env
*.env
.env.*
*.key
*.pem
*.p12
secrets/
config.local.json

# Build artifacts
dist/
build/
*.log

# Reports may contain local paths — review before committing
reports/*.local.md

# Evolver runtime state (do NOT commit GEP store / memory graph at repo root)
# These are generated when `evolver run` is invoked from repo root.
# Fixture copies in cases/*/fixtures/*/.evolver/ ARE intentionally committed as test artifacts.
.evolver/
memory/
