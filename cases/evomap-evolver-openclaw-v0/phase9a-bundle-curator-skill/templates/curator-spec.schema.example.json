{
  "schema_version": "atl-evomap-curator-spec-v0.1",
  "doc_purpose": "Reference example for the bundle-curator input spec. Documents required fields, recommended values, and the safety contract that the curator (scripts/evomap_curate_bundle.py) enforces. NOT an executable spec; use specs/sample-safe-bundle.curator-spec.json or your own derived spec for actual runs.",
  "bundle": {
    "schema_version": "atl-evomap-portable-bundle-v0.1",
    "source_phase": "ATL-EVOMAP-9A-SAMPLE",
    "target_gene_id": "gene_distilled_sample-safe-bundle",
    "target_capsule_id": "capsule_sample_safe_bundle_phase9a",
    "visibility": "private"
  },
  "gene": {
    "type": "Gene",
    "id": "gene_distilled_sample-safe-bundle",
    "category": "repair",
    "signals_match": [
      "sample_failure",
      "sample_failure:fixture",
      "session_context",
      "repo_context"
    ],
    "strategy": [
      "Read the fixture first.",
      "Extract stable failure signals.",
      "Make one minimal change per validation cycle.",
      "Record evidence without secrets."
    ],
    "constraints": {
      "max_files": 8,
      "forbidden_paths": [".git", "node_modules", ".evolver", "memory", ".env", "real_runtime_root"],
      "forbidden_actions": ["print_secret", "call_network", "mutate_real_config"]
    },
    "summary": "Sample safe bundle generated by bundle curator."
  },
  "capsule": {
    "schema_version": "1.6.0",
    "type": "Capsule",
    "id": "capsule_sample_safe_bundle_phase9a",
    "gene": "gene_distilled_sample-safe-bundle",
    "status": "success",
    "confidence": 0.80,
    "visibility": "private",
    "source": "bundle_curator_sample_phase9a",
    "trigger": ["sample_failure", "session_context"],
    "blast_radius": {"files": 0, "lines": 0},
    "execution_trace": [
      {
        "stage": "build",
        "command": "parse sample fixture",
        "exit_code": 0,
        "result": "fixture_parsed"
      },
      {
        "stage": "validate",
        "command": "validate generated bundle",
        "exit_code": 0,
        "result": "bundle_validate_pass"
      },
      {
        "stage": "canary",
        "command": "safety_check",
        "exit_code": 0,
        "result": {
          "no_hub": true,
          "no_publish": true,
          "no_approve": true,
          "no_solidify": true,
          "no_secret": true
        }
      }
    ]
  },
  "fixture_summary": {
    "sample": true,
    "offline": true,
    "no_secret": true
  },
  "safety": {
    "hub": "disabled",
    "publish": "disabled",
    "credits": 0,
    "visibility": "private",
    "no_failed_events": true,
    "no_pollution_signals": true,
    "no_secrets": true
  },
  "_doc_field_requirements": {
    "top_level_required": ["schema_version", "bundle", "gene", "capsule", "safety"],
    "bundle_required": ["schema_version", "source_phase", "target_gene_id", "target_capsule_id", "visibility"],
    "gene_required": ["type", "id", "category", "signals_match", "strategy", "summary"],
    "capsule_required": ["schema_version", "type", "id", "gene", "status", "confidence", "visibility", "source", "trigger", "execution_trace"],
    "capsule_constraints": {
      "execution_trace_min_steps": 3,
      "visibility_must_be": "private"
    },
    "safety_required_keys": ["hub", "publish", "credits", "visibility"],
    "safety_required_values": {
      "hub": "disabled",
      "publish": "disabled",
      "credits": 0,
      "visibility": "private"
    },
    "invariant_checks": [
      "gene.id == bundle.target_gene_id",
      "capsule.id == bundle.target_capsule_id",
      "capsule.gene == gene.id",
      "len(capsule.execution_trace) >= 3"
    ],
    "denylisted_signal_names": [
      "user_feature_request",
      "consecutive_failure",
      "consecutive_failure_streak",
      "high_failure_ratio",
      "stable_success_plateau",
      "evolution_saturation",
      "explore_opportunity",
      "memory_missing",
      "hub_search_miss_with_problem",
      "token",
      "secret",
      "cookie",
      "authorization",
      "private_key",
      "api_key",
      "bearer",
      "password"
    ],
    "denylisted_secret_patterns": [
      "OpenAI API key shape (sk-...)",
      "GitHub PAT shape (ghp_, ghs_, gho_, ghu_, ghr_)",
      "Authorization: Bearer header value",
      "JWT shape (eyJ...)",
      "BEGIN PRIVATE KEY block",
      "12+ digit pure numeric token"
    ]
  }
}